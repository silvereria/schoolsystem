# Local development example only. Never upload this file to a web root.
# VITE_* values are public and embedded in the frontend build; never put secrets in them.
NODE_ENV="development"
PORT=3000

# ─── DATA SOURCE ─────────────────────────────────────────────
# 'mock' is development-only; production builds are forced to use the PHP API.
VITE_DATA_SOURCE="mock"

# Public PHP API base URL; production builds use https://<host>/backend/api.
VITE_API_BASE_URL="http://localhost/school-management/backend/api"
# APP_ENV must be development, test, or production. Staging uses production settings.
APP_ENV="development"
# Development Express server only; do not deploy server.ts to cPanel.
PHP_API_BASE_URL=""
# Optional Sentry project DSN. Events are sanitized and default PII is disabled.
SENTRY_DSN=""

# ─── DATABASE CONNECTION ─────────────────────────────────────
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="ntake_sms"
# PHP-FPM uses a dedicated runtime account with no DDL privileges.
DB_USER=""
DB_PASS=""
# Account-provisioning scripts only; never place these in PHP-FPM configuration.
DB_RUNTIME_HOST="127.0.0.1"
DB_ADMIN_HOST="127.0.0.1"
DB_ADMIN_PORT="3306"
DB_ADMIN_USER=""
DB_ADMIN_PASS=""
# CLI migrations only; keep separate from the runtime account.
MIGRATION_DB_HOST="127.0.0.1"
MIGRATION_DB_PORT="3306"
MIGRATION_DB_USER=""
MIGRATION_DB_PASS=""
# Migration integration tests only; never point these at the live database.
DB_TEST_ADMIN_HOST="127.0.0.1"
DB_TEST_ADMIN_PORT="3306"
DB_TEST_ADMIN_USER=""
DB_TEST_ADMIN_PASS=""
# CLI installer only; remove from runtime configuration after initial setup.
INSTALL_ADMIN_USERNAME=""
INSTALL_ADMIN_EMAIL=""
INSTALL_ADMIN_PASSWORD=""
INSTALL_ADMIN_PHONE=""

# Absolute path for persistent uploads; keep outside the web root.
# If omitted, the API derives a private sibling directory and still rejects web-root paths.
UPLOADS_DIR=""

# ─── ENCRYPTED DATABASE BACKUPS ──────────────────────────────
# Absolute persistent directory outside the project and web root.
BACKUP_STORAGE_DIR=""
# Generate with: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# Store separately from backup files; losing this key prevents recovery.
BACKUP_ENCRYPTION_KEY=""
BACKUP_RETENTION_DAYS=30
# Optional absolute executable paths; otherwise mysqldump/mysql must be on PATH.
MYSQLDUMP_PATH=""
MYSQL_PATH=""

# ─── SMS GATEWAY ─────────────────────────────────────────────
# Leave blank until real credentials are provisioned.
# Supported providers: africas_talking | infobip | generic
SMS_PROVIDER="africas_talking"
SMS_API_URL=""
SMS_API_KEY=""
SMS_USERNAME=""
SMS_SENDER_ID="NTAKE_SS"
INTERNAL_DISPATCH_SECRET=""

# ─── BIOMETRIC HARDWARE ──────────────────────────────────────
# Development only. Mock provider is rejected in production; real hardware support is pending.
FINGERPRINT_PROVIDER="mock"
# Base64-encoded 32-byte key; keep private and separate from encrypted data/backups.
BIOMETRIC_TEMPLATE_ENCRYPTION_KEY=""

# ─── SESSION CONFIGURATION ───────────────────────────────────
# Required in production; one common/compromised password per line.
PASSWORD_BLOCKLIST_FILE=""
TOTP_ENCRYPTION_KEY=""

# ─── CRON / BACKGROUND JOBS ──────────────────────────────────
# Used by sms-retry.php when called from cron
CRON_SECRET=""

# ─── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
