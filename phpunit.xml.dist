<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="backend/vendor/autoload.php"
         colors="true"
         cacheDirectory="backend/vendor/phpunit-cache">
    <testsuites>
        <testsuite name="Critical business rules">
            <directory>backend/tests/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <file>backend/core/auth.php</file>
            <file>backend/core/payment-ledger.php</file>
            <file>backend/core/marks-workflow.php</file>
        </include>
    </source>
</phpunit>
